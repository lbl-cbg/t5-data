{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "format": "uri"
    },
    "user": {
      "type": "string",
      "format": "email"
    },
    "token_file": {
      "type": "string"
      "pattern": "^(?:[a-zA-Z]:\\\\|\\/)?(?:[^\\\\/:*?\"<>|]+\\\\|[^\\\\/:*?\"<>|]+)/?$"
    },
    "database": {
      "type": "string"
      "pattern": "^(?:[a-zA-Z]:\\\\|\\/)?(?:[^\\\\/:*?\"<>|]+\\\\|[^\\\\/:*?\"<>|]+)/?$"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "new_status": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        },
        "required": ["project", "new_status", "command"]
      }
    }
  },
  "required": ["host", "user", "token_file", "database", "projects"]
}
